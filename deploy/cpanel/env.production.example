APP_NAME=EtiCart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.ornekdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=eticart
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_RETRY_AFTER=650
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@ornekdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Paylaşımlı hosting cron (minimum 15 dakika)
SCHEDULE_CRON_MINUTES=15

# API bilgileri panel Ayarlar'dan veritabanına yazılır (.env zorunlu değil)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_APP_URL=https://panel.ornekdomain.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

UYUMSOFT_API_USER=
UYUMSOFT_API_PASSWORD=
UYUMSOFT_BASE_URL=
UYUMSOFT_WAREHOUSE_ID=

SMS_PROVIDER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_HEADER=ETICART
